{
  "name": "usrr",
  "version": "0.0.0",
  "description": "A per-Linux-user resident Gemini agent: attach, message, status, and wait until idle",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brooswit-factory/usrr.git"
  },
  "homepage": "https://github.com/brooswit-factory/usrr#readme",
  "bugs": {
    "url": "https://github.com/brooswit-factory/usrr/issues"
  },
  "bin": {
    "usrr": "./src/cli/bin.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "check": "bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@brooswit/drovr": "https://github.com/brooswit-factory/drovr/releases/download/v0.6.0/brooswit-drovr-0.6.0.tgz"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.3.11"
  }
}
